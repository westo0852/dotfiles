[init]
	defaultBranch = main
[user]
	name = westo0852
	email = iweston1702@gmail.com
[core]
	editor = nvim
	pager = diff-so-fancy | less --tabs=4 -RF
[pull]
	rebase = true
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
[commit]
	verbose = true
[stash]
	showPatch = true
[push]
	autoSetupRemote = true
